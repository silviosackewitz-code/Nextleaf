# Starts on your Mac, reachable only from your Mac by default.
TASKMANAGER_BIND=127.0.0.1:8787
TASKMANAGER_DATABASE_URL=sqlite://../data/taskmanager.db
# Optionally serve the built web app with the Rust API (relative to backend/).
TASKMANAGER_WEB_DIR=../frontend/dist
# A different server URL can be set in the UI under “Connection”.

# MCP is disabled without a strong secret. Generate one; never commit the real value.
NEXTLEAF_MCP_TOKEN=
# Comma-separated allowed Host names; add the exact private Tailscale hostname.
NEXTLEAF_MCP_HOSTS=localhost,127.0.0.1
