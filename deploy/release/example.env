# Set the exact published image version or digest from the matching release.
# Application 0.1.0; installation files revision 2.
TASKMANAGER_IMAGE=ghcr.io/silviosackewitz-code/nextleaf:0.1.0

# Install this file as /opt/nextleaf-app/.env alongside docker-compose.yml.
# Back up /opt/nextleaf-app and a consistent copy of /srv/nextleaf.
# Absolute host path. Create it for container user 10001:10001 before starting.
NEXTLEAF_DATA_DIR=/srv/nextleaf

# Optional: empty disables central MCP. Never commit a real secret.
NEXTLEAF_MCP_TOKEN=
NEXTLEAF_MCP_HOSTS=localhost,127.0.0.1
